{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schemaVersion","runId","decision","failedGates","stopConditions","sourceManifestSha256","reproductionCommand"],"properties":{"schemaVersion":{"const":1},"runId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},"decision":{"enum":["proceed","proceed_with_constraints","reject"]},"failedGates":{"type":"array","uniqueItems":true,"items":{"enum":["protocol","authentication","allowance","structured_output","containment","conversation_ownership","provider_cleanup","provider_neutrality"]}},"stopConditions":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{1,79}$"}},"sourceManifestSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"reproductionCommand":{"const":"npm run validate:gate-decision"}}}
