{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectos.local/schemas/supported-runtime-manifest.schema.json",
  "title": "ProjectOS supported Codex runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "manifestId",
    "runtime",
    "generation",
    "schemas",
    "requiredMethods",
    "enabledDispatch"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "manifestId": { "$ref": "#/$defs/safeIdentifier" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "platform", "architecture", "binaryContentSha256"],
      "properties": {
        "build": {
          "type": "string",
          "pattern": "^codex(?:-cli)?\\s+[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "platform": { "$ref": "#/$defs/safeIdentifier" },
        "architecture": { "$ref": "#/$defs/safeIdentifier" },
        "binaryContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonArgv", "typescriptArgv", "digestAlgorithm"],
      "properties": {
        "jsonArgv": { "const": ["app-server", "generate-json-schema", "--out", "$JSON_OUT"] },
        "typescriptArgv": { "const": ["app-server", "generate-ts", "--out", "$TS_OUT"] },
        "digestAlgorithm": { "const": "projectos-schema-tree-sha256-v1" }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "typescript"],
      "properties": {
        "json": { "$ref": "#/$defs/schemaBundle" },
        "typescript": { "$ref": "#/$defs/schemaBundle" }
      }
    },
    "requiredMethods": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientRequests",
        "clientNotifications",
        "serverNotifications",
        "serverRequests",
        "recognizedForbidden"
      ],
      "properties": {
        "clientRequests": {
          "allOf": [
            { "$ref": "#/$defs/methods" },
            { "contains": { "const": "initialize" }, "minContains": 1, "maxContains": 1 }
          ]
        },
        "clientNotifications": {
          "allOf": [
            { "$ref": "#/$defs/methods" },
            { "contains": { "const": "initialized" }, "minContains": 1, "maxContains": 1 }
          ]
        },
        "serverNotifications": { "$ref": "#/$defs/methods" },
        "serverRequests": { "$ref": "#/$defs/methods" },
        "recognizedForbidden": { "$ref": "#/$defs/methods" }
      }
    },
    "enabledDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRequests", "clientNotifications"],
      "properties": {
        "clientRequests": { "const": ["initialize"] },
        "clientNotifications": { "const": ["initialized"] }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "methods": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._/-]{0,255}$" }
    },
    "schemaBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files", "aggregateSha256"],
      "properties": {
        "algorithm": { "const": "projectos-schema-tree-sha256-v1" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "aggregateSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
